---
import "../styles/global.css";
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Título SEO -->
    <title>Women Game Jam Bolivia 2025 | Crea videojuegos, conoce gente y diviértete</title>

    <!-- Descripción SEO -->
    <meta name="description" content="Únete a la Women Game Jam Bolivia 2025, un evento de creación de videojuegos enfocado en impulsar a mujeres y personas no binarias en la industria tech. ¡Conecta, aprende y crea!" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph para compartir en redes -->
    <meta property="og:title" content="Women Game Jam Bolivia 2025" />
    <meta property="og:description" content="Hackatón de videojuegos para mujeres y personas no binarias. Participa del WGJ Bolivia 2025 y vive una experiencia única de creación, comunidad y diversión." />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:url" content="https://wgj.gdg.com.bo" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Women Game Jam Bolivia 2025" />
    <meta name="twitter:description" content="Un evento gratuito y colaborativo para crear videojuegos en Bolivia. ¡Regístrate y vive la experiencia!" />
    <meta name="twitter:image" content="/favicon.svg" />

    <!-- Idioma y localización -->
    <meta name="language" content="es" />
    <meta name="country" content="BO" />
  </head>

  <body class="bg-primary md:pt-20 pt-16">
    <slot />
    <Footer lang="es" />
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</html>