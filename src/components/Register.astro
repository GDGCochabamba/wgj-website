---
import Wgj2026 from "../assets/wgj-2026.svg";
import CalendarIcon from "../assets/calendar-icon.svg";
import InternetIcon from "../assets/internet-icon.svg";
import StartLeft from "../assets/start_left.svg";
import CloudLeft from "../assets/cloud_left.svg";
import StartRight from "../assets/start_right.svg";
import CloudRight from "../assets/cloud_right.svg";

import es from "../locale/es.json";
import en from "../locale/en.json";

export interface Props {
  lang: "es" | "en";
}

const { lang }: Props = Astro.props;
const t = lang === "es" ? es.register : en.register;
---
<section class="bg-primary py-16" id="hero">
  <div class="w-full flex flex-col items-end">
    <StartRight  class="my-[-1px] mr-35"/>
    <CloudRight  class="opacity-100 my-[-1px]"/>
  </div>
  <div class=" text-center max-w-4xl mx-auto">
    <div class="grid grid-cols-1 min-[941px]:grid-cols-2 gap-8 items-center">
      <Wgj2026 class="w-full max-w-[383px] col-span-1 justify-self-center min-[941px]:justify-self-start"/>
      <div class="flex flex-col col-span-1">
        <h2 class="font-bold text-[48px] leading-[100%] text-center text-secondary font-display-text-play text-border">
          {t.title}
        </h2>
        <br />
        <p class="text-[24px] leading-[120%] text-white-secondary font-semibold text-center font-display-text-play mb-2">
          {t.description1}
          <br/>
          {t.description2}
        </p>
        <br />
        <div class="grid grid-cols-2 md:grip-cols-1">
          <div class="flex col-span-1">
            <CalendarIcon class="mb-1" />
            <span class="text-[24px] font-bold text-white-secondary font-display-text-play pl-2">{t.date}</span>
          </div>
          <div class="flex col-span-1 pl-2">
            <InternetIcon />
            <span class="text-[24px] font-bold text-white-secondary font-display-text-play pl-2">{t.eventType}</span>
          </div>
        </div>
        <br />
        <div class="justify-center flex gap-4">
          <a href="https://tally.so/r/1ABb2L" target="_blank"
             class="bg-secondary text-black font-bold font-display-text px-4 py-2 rounded hover:scale-105 transition text-xs md:text-sm">
            {t.action}
          </a>
          <a href="https://www.womengamejam.org/" target="_blank"
             class="bg-secondary text-black font-bold font-display-text px-4 py-2 rounded hover:scale-105 transition text-xs md:text-sm">
            {t.action_2}
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="max-w-xl bottom-2/4 pt-10">
    <StartLeft class="my-[-1px] ml-20"/>
    <CloudLeft class="my-[-1px]"/>
  </div>
</section>

