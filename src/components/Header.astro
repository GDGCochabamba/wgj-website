---
import Logo from '../assets/logo.svg';
import es from '../locale/es.json';
import en from '../locale/en.json';

export interface Props {
  lang: 'es' | 'en';
}

const { lang }: Props = Astro.props;
const t = lang === 'es' ? es.header : en.header;
---

<header class="w-full bg-quaternary shadow fixed top-0 left-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 md:px-20 py-4">
    <!-- Logo -->
    <a href="/" aria-label="Go to homepage" class="flex items-center transition-transform duration-300 hover:scale-105">
      <Logo class="h-8 w-auto" />
    </a>

    <!-- Contenedor del nav + botón -->
    <div class="flex justify-between items-center ml-6">
      <!-- Navigation -->
      <nav class="flex items-center justify-around space-x-4">
        <!-- Enlaces de navegación -->
        <a href="#hero" class="text-white hover:scale-105 transition text-xs md:text-sm">{t.home}</a>
        <a href="#about" class="text-white hover:scale-105 transition text-xs md:text-sm">{t.about}</a>
        <a href="#participants" class="text-white hover:scale-105 transition text-xs md:text-sm">{t.participants}</a>
        <a href="#organizers" class="text-white hover:scale-105 transition text-xs md:text-sm">{t.organizers}</a>
        <a href="#sponsors" class="text-white hover:scale-105 transition text-xs md:text-sm">{t.sponsors}</a>

        <!-- Botón -->
        <a 
          href="#contact"
          class="bg-secondary text-black font-semibold px-4 py-2 rounded hover:scale-105 transition text-xs md:text-sm"
        >
          Registrarme
        </a>
      </nav>
    </div>
  </div>
</header>