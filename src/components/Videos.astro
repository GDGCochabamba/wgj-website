---
import CloudStart from '../assets/cloud-start.svg';
import CloudEnd from '../assets/cloud-end.svg';
import es from '../locale/es.json';
import en from '../locale/en.json';

import VideoCarousel from '../react/VideoCarousel.jsx';

export interface Props {
  lang: 'es' | 'en';
}

const { lang }: Props = Astro.props;
const t = lang === 'es' ? es.videos : en.videos;
const videos = [
  "https://www.youtube.com/embed/eXTlzyO9lUY",
  "https://www.youtube.com/embed/rlyI_A4AP3E",
  "https://www.youtube.com/embed/PbL_iJDv8zw"
];
---
<CloudStart viewBox="0 0 1441.631 72.493" class="w-full h-auto opacity-100 my-[-1px]"/>
<div class="bg-cloud w-full h-[533.7195px] pt-16 pb-16">
  <p class="font-bold text-[48px] leading-[100%] text-center text-yellow-title font-display-title text-border">{t.title}</p> 
  <VideoCarousel videos={videos} client:load />
</div>    
<CloudEnd viewBox="0 0 1441.631 72.493" class="w-full h-auto opacity-100 my-[-1px]"/>

