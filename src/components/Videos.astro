---
import CloudStart from '../assets/cloud-start.svg';
import CloudEnd from '../assets/cloud-end.svg';
import es from '../locale/es.json';
import en from '../locale/en.json';

export interface Props {
  lang: 'es' | 'en';
}

const { lang }: Props = Astro.props;
const t = lang === 'es' ? es.videos : en.videos;
---
<CloudStart viewBox="0 0 1441.631 72.493" class="w-full h-auto opacity-100"/>
<div class="bg-cloud w-full h-[533.7195px] pt-16 pb-16 flex flex-col gap-16">
  <p class="font-bold text-[48px] leading-[100%] text-center text-yellow-title font-display-title text-border">{t.title}</p> 
  <div class="flex flex-row justify-center gap-3">
    <div class="px-5">
        <iframe
          class="w-[539px] h-[304px]"
          src="https://www.youtube.com/watch?v=eXTlzyO9lUY"
          allowfullscreen
        ></iframe>
    </div>
    <div class="px-5">
      <iframe
        class="w-[539px] h-[304px]"
        src="https://www.youtube.com/watch?v=rlyI_A4AP3E"
        allowfullscreen
      ></iframe>
    </div>
    <div class="px-5">
      <iframe
        class="w-[539px] h-[304px]"
        src="https://www.youtube.com/watch?v=PbL_iJDv8zw"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>    
<CloudEnd viewBox="0 0 1441.631 72.493" class="w-full h-auto opacity-100"/>

